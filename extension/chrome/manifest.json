{
  "manifest_version": 3,
  "name": "Karaoke Submitter",
  "short_name": "Karaoke",
  "description": "Submit the current video page or link to a configured Karaoke queue (vocals + instrumental playback + lyrics).",
  "version": "0.4.2",
  "action": {
    "default_title": "Submit video to Karaoke",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "cookies",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://*.oklabs.uk/*",
    "http://10.10.0.13:13140/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/karaoke-16.png",
    "48": "icons/karaoke-48.png",
    "128": "icons/karaoke-128.png"
  }
}
